CREATE DATABASE IF NOT EXISTS dw;
USE dw;

CREATE EXTERNAL TABLE IF NOT EXISTS dw.dim_product (
    product_key           BIGINT,
    product_id            STRING,
    product_category_name STRING,
    product_weight_g      INT,
    product_length_cm      INT,
    product_height_cm      INT,
    product_width_cm       INT,
    product_price         DECIMAL(10,2),
    dw_start_date         DATE,
    dw_end_date           DATE
)
STORED AS PARQUET
LOCATION '/user/student/dim_data/dim_product';

CREATE EXTERNAL TABLE IF NOT EXISTS dw.dim_customer (
    cust_key            INT,
    customer_unique_id  STRING,
    customer_city       STRING,
    customer_state      STRING,
    recency             INT,
    frequency           BIGINT,
    monetary            DOUBLE,
    recency_score       INT,
    frequency_score     INT,
    monetary_score      INT,
    RFM_SCORE           STRING,
    Segment             STRING
)
STORED AS PARQUET
LOCATION '/user/student/dim_data/dim_customer';

CREATE EXTERNAL TABLE IF NOT EXISTS dw.dim_date (
    date_key    INT,
    full_date   DATE,
    year        INT,
    quarter     INT,
    month       INT,
    day         INT
)
STORED AS PARQUET
LOCATION '/user/student/dim_data/dim_date';

CREATE EXTERNAL TABLE IF NOT EXISTS dw.fact_sales (
    sales_key               BIGINT,
    order_id                STRING,
    customer_id             STRING,
    product_id              STRING,
    order_purchase_date_key INT,
    order_status            STRING,
    price                   DOUBLE,
    freight_value           DOUBLE,
    payment_value           DOUBLE,
    payment_type            STRING
)
PARTITIONED BY (order_year INT, order_month INT)
STORED AS PARQUET
LOCATION '/user/student/fact_data/fact_sales';
MSCK REPAIR TABLE dw.fact_sales;

SHOW TABLES IN dw;
