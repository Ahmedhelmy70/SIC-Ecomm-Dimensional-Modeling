     ]
    }
   ],
   "source": [
    "raw_customers = read_table(\"raw_customers\")\n",
    "raw_customers.show(5)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "16daa562",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "customers: 99441\n",
      "products: 32951\n",
      "orders: 99441\n",
      "order_items: 112650\n",
      "order_payments: 103886\n"
     ]
    }
   ],
 {
   "cell_type": "markdown",
   "id": "b6b7bb1c",
   "metadata": {},
   "source": [
    "## Landing Raw Data on HDFS (Raw Zone)"
   ]
  },
   "source": [
    "raw_products = read_table(\"raw_products\")\n",
    "raw_orders = read_table(\"raw_orders\")\n",
    "raw_order_items = read_table(\"raw_order_items\")\n",
    "raw_order_payments = read_table(\"raw_order_payments\")\n",
    "\n",
    "print(\"\")\n",
    "for name, df in [\n",
    "    (\"customers\", raw_customers),\n",
    "    (\"products\", raw_products),\n",
    "    (\"orders\", raw_orders),\n",
    "    (\"order_items\", raw_order_items),\n",
    "    (\"order_payments\", raw_order_payments),\n",
    "]:\n",
    "    print(f\"{name}: {df.count()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "595daab6",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "                                                                                \r"
     ]
    }
   ],
   "source": [
    "RAW_ZONE_PATH = \"/raw_zone\"\n",
    "\n",
    "raw_customers.write.mode(\"overwrite\").parquet(f\"{RAW_ZONE_PATH}/customers\")\n",
    "raw_products.write.mode(\"overwrite\").parquet(f\"{RAW_ZONE_PATH}/products\")\n",
    "raw_orders.write.mode(\"overwrite\").parquet(f\"{RAW_ZONE_PATH}/orders\")\n",
    "raw_order_items.write.mode(\"overwrite\").parquet(f\"{RAW_ZONE_PATH}/order_items\")\n",
    "raw_order_payments.write.mode(\"overwrite\").parquet(f\"{RAW_ZONE_PATH}/order_payments\")"
   ]
  },
