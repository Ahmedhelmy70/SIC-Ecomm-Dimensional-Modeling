   "id": "c18e8794",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.sql import SparkSession, functions as F\n",
    "from pyspark.sql.window import Window"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8a2052df",
   "metadata": {},
   "outputs": [],
   "source": [
    "MYSQL_HOST = \"localhost\"\n",
    "MYSQL_PORT = \"3306\"\n",
    "MYSQL_DB = \"olist_raw\"\n",
    "MYSQL_USER = \"student\"\n",
    "MYSQL_PASSWORD = \"student\"\n",
    "\n",
    "JDBC_URL = f\"jdbc:mysql://{MYSQL_HOST}:{MYSQL_PORT}/{MYSQL_DB}?useSSL=false&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull\"\n",
    "\n",
    "JDBC_PROPERTIES = {\n",
    "    \"user\": MYSQL_USER,\n",
    "    \"password\": MYSQL_PASSWORD,\n",
    "    \"driver\": \"com.mysql.jdbc.Driver\"\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "ad3c4438",
   "metadata": {},
   "outputs": [],
   "source": [
    "spark = (\n",
    "    SparkSession.builder\n",
    "    .appName(\"Ingestion_to_hdfs\")\n",
    "    .config(\"spark.jars\", \"/usr/local/spark3/spark-3.1.2-bin-hadoop3.2/jars/mysql-connector-java-5.1.47.jar\")\n",
    "    .getOrCreate()\n",
    ")\n",
    "\n",
    "spark.sparkContext.setLogLevel(\"WARN\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "abd66a52",
   "metadata": {},
   "outputs": [],
   "source": [
    "def read_table(table_name: str):\n",
    "    \n",
    "    return spark.read.jdbc(url=JDBC_URL, table=table_name, properties=JDBC_PROPERTIES)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "48528484",
   "metadata": {},
   "source": [
    "## Ingestion — Reading Raw Tables from MySQL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "10c3e4db",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "[Stage 0:>                                                          (0 + 1) / 1]\r"
